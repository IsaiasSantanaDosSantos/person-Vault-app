NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Opcional — sem essas duas, o rate limiting de /share/[id] vira no-op
# (ver lib/rateLimit.ts). Crie um banco Redis gratuito em upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional — sem essa, o CAPTCHA (Cloudflare Turnstile) na tela de login/criar
# conta/recuperar senha não aparece (ver components/Turnstile.tsx). Crie um
# site grátis em dash.cloudflare.com/?to=/:account/turnstile — essa é a
# "Site Key" (pública, tudo bem expor). A "Secret Key" NÃO vai aqui: ela é
# colada no painel do Supabase (Authentication → Settings → CAPTCHA).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
